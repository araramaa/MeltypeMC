@echo off
chcp 65001 > nul
echo ========================================================
echo   Meltype MC (Fabric Mod) のビルドを開始します...
echo ========================================================
echo.

cd /d "%~dp0"
call gradlew.bat build

if %ERRORLEVEL% equ 0 (
    echo.
    echo ========================================================
    echo   【ビルド成功！】
    echo   完成したMODファイル:
    echo   build\libs\meltype-mc-1.0.0.jar
    echo   このファイルを .minecraft\mods フォルダに入れてください。
    echo ========================================================
) else (
    echo.
    echo ========================================================
    echo   【ビルドエラー】
    echo   ビルド中に問題が発生しました。
    echo ========================================================
)

echo.
pause
